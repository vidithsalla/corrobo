{
  "name": "corrobo",
  "version": "0.1.0",
  "description": "A small deterministic runtime for reconciling side-effecting operations: separates transport evidence from business truth and produces a conservative recovery disposition.",
  "license": "MIT",
  "homepage": "https://github.com/vidithsalla/corrobo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidithsalla/corrobo.git"
  },
  "bugs": {
    "url": "https://github.com/vidithsalla/corrobo/issues"
  },
  "keywords": [
    "reliability",
    "idempotency",
    "side-effects",
    "postgres",
    "agents"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./postgres": {
      "types": "./dist/stores/postgres.d.ts",
      "default": "./dist/stores/postgres.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "postgres": ["dist/stores/postgres.d.ts"],
      "testing": ["dist/testing/index.d.ts"]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:rest": "tsx examples/rest/demo.ts",
    "example:stripe": "tsx examples/stripe-refund/demo.ts",
    "example:stripe:live-smoke": "tsx examples/stripe-refund/live-smoke.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "stripe": "^17.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
